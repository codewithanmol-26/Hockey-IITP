# Local use: copy to .env. On Vercel: add the same names under Settings > Environment Variables.
CAPTAIN_CODE=change-me-captain
VICE_CODE=change-me-vice
TOKEN_SECRET=put-a-long-random-string-here
# Only needed if the frontend is hosted on a different address than the backend
ALLOWED_ORIGIN=*
# Push notifications (playing day scheduled / cancelled). Make the pair once with:  npm run vapid
# Put BOTH keys in Vercel > Settings > Environment Variables, then redeploy. VAPID_SUBJECT is any mailto: address of yours.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# E-mail sign-up codes (Resend, https://resend.com). Needed for first-time player sign-up.
# RESEND_FROM must be an address on a domain you verified in Resend, e.g. "Inter IIT Hockey <hockey@yourdomain.com>".
# (Without a verified domain Resend only delivers to your own e-mail, which is fine for a test but not for the team.)
RESEND_API_KEY=
RESEND_FROM=
# Sign-up e-mails can be from any domain by default, so you can leave this out. Set a domain (e.g. iitp.ac.in) to restrict sign-ups to it.
# SIGNUP_EMAIL_DOMAIN=iitp.ac.in

# Reminders about the next playing day (sent by Vercel Cron, see vercel.json). Make up any long random text, e.g. 40 letters and digits.
# Vercel sends it automatically with each cron call. Without it the reminders do not run.
CRON_SECRET=

# Supabase (Settings > API in your Supabase project dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side only: keep this secret and never expose in frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (AI Chatbot)
GEMINI_API_KEY=your-gemini-api-key

