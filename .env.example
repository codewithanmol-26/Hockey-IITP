# Local use: copy to .env. On Vercel: add the same names under Settings > Environment Variables.
CAPTAIN_CODE=change-me-captain
VICE_CODE=change-me-vice
TOKEN_SECRET=put-a-long-random-string-here
# Whole service-account JSON pasted on ONE line (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT=
# Only needed if the frontend is hosted on a different address than the backend
ALLOWED_ORIGIN=*
# Push notifications (playing day scheduled / cancelled). Make the pair once with:  npm run vapid
# Put BOTH keys in Vercel > Settings > Environment Variables, then redeploy. VAPID_SUBJECT is any mailto: address of yours.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# E-mail sign-up codes (Resend, https://resend.com). Needed for first-time player sign-up.
# RESEND_FROM must be an address on a domain you verified in Resend, e.g. "Inter IIT Hockey <hockey@yourdomain.com>".
# (Without a verified domain Resend only delivers to your own e-mail, which is fine for a test but not for the team.)
RESEND_API_KEY=
RESEND_FROM=
# Optional: only allow sign-up e-mails from this domain, e.g. iitp.ac.in. Leave empty to allow any e-mail.
SIGNUP_EMAIL_DOMAIN=
